generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
}

enum Column {
  TODO
  IN_PROGRESS
  DONE
}

model Card {
  id          String   @id
  boardId     String
  title       String
  description String
  column      Column
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([boardId, column, position])
}